# Organizer's hosted PostgreSQL (read-only, provided in hackathon brief)
PG_DSN=postgresql://database_database_w2a1_user:JvqVh0msmuBrwgING68S52H0sz3wEEXI@dpg-d7auudv5r7bs738iqh70-b.replica-cyan.oregon-postgres.render.com/database_database_w2a1

# LLM provider: ollama (default, Ollama Cloud) | bedrock (legacy AWS)
