# Secrets
.env
.env.local

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Node / Next.js
node_modules/
.next/
out/
.turbo/

# Local data caches (gitignored — rebuilt at runtime)
data/duckdb_cache/
data/*.parquet

# Full local hackathon dataset. The small deployable subset lives in
# backend/data and is intentionally trackable.
april-26-hackathon-dataset/**

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

terraform/terraform.tfvars

# Terraform state + provider binaries (state contains secrets; binaries are huge and rebuilt by `terraform init`)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*

# Lambda packages — rebuilt by `uv run backend/package_agents.py`
backend/**/*.zip

# SQLite jobstore (deploy-branch runtime state)
backend/*.db
backend/*.db-shm
backend/*.db-wal
